# Copy to .env and fill in. .env is git-ignored; never commit it.
# Write values WITHOUT quotes (kubectl --from-env-file keeps quotes literally).

# --- Required: your iAqualink account (the same login as the iAqualink app) ---
IAQUALINK_USERNAME=you@example.com
IAQUALINK_PASSWORD=change-me
# Only if the account has several pool systems (see `python -m app.discover`):
# IAQUALINK_SERIAL=

# Try the UI without touching your pool first: JANDY_BACKEND=mock
JANDY_BACKEND=iaqualink

# --- Which panel device each control drives: a key (aux_2) or a label (Spillover) ---
# Run `docker compose run --rm pool python -m app.discover` to list yours.
# JANDY_FILTER_PUMP_DEVICE=pool_pump
# JANDY_SPA_MODE_DEVICE=spa_pump
# JANDY_SPA_HEATER_DEVICE=spa_heater
# JANDY_BUBBLES_DEVICE=aux_2
# JANDY_WATER_FEATURES_DEVICE=Aux V1
# JANDY_SPILLOVER_DEVICE=Spillover
# JANDY_LIGHT_DEVICE=            (empty = the first light on the panel)

# --- Guest limits (°F) ---
# SPA_MIN=80
# SPA_MAX=103
# POOL_HEAT_MIN=82
# POOL_HEAT_MAX=92
# POOL_CHILL_MAX=92
# POOL_MIN_SPREAD=5

# --- Owner settings & Advanced controls (optional) ---
# OWNER_PIN (4-12 digits) turns on the owner section (Advanced controls and Settings).
# OWNER_PIN=
# Keeps owners signed in across restarts (any long random string); unset = a new
# random secret at every start.
# OWNER_SECRET=
# Proxies whose X-Forwarded-For is trusted for the PIN rate limit (IPs or CIDRs).
# OWNER_TRUSTED_PROXIES=10.42.0.0/16
# Where settings saved from the page are kept (compose mounts a volume at /data).
# Once saved, they replace the guest limits, toggles and weather location set here.
# CONFIG_PATH=/data/config.json

# --- Weather card (optional; off unless a location is set) ---
# WEATHER_ZIP=12345            (US zip; WEATHER_COUNTRY=ca/gb/de/... for others)
# WEATHER_LAT=  WEATHER_LON=   (instead of a zip)
# WEATHER_LABEL=Home
# WEATHER_TZ=auto

# --- Polling ---
# POLL_SECONDS=15
# IDLE_SECONDS=60
